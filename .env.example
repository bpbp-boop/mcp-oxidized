# Oxidized MCP Server Configuration Example
# Copy this file to .env and customize for your environment

# Oxidized server URL (default: http://localhost:8888)
OXIDIZED_URL=http://localhost:8888

# Optional: Oxidized authentication credentials
# OXIDIZED_USER=admin
# OXIDIZED_PASSWORD=your_password_here

# Optional: Read password from file instead of env var (more secure)
# OXIDIZED_PASSWORD_FILE=/path/to/password/file

# Optional: Rust logging level (default: info)
# RUST_LOG=debug
